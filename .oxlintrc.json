{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "overrides": [
    {
      "files": ["aifn-js/examples/src/recipes/**"],
      "rules": {
        "react/only-export-components": [
          "warn",
          {
            "allowConstantExport": true,
            "allowExportNames": ["recipe"]
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["site/src/components/ui/**", "aifn-js/render/src/ui/**", "site/src/generated/**", "dist/**"]
}
