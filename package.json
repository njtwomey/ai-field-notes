{
  "name": "ai-field-notes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:content && tsc -b && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:content": "node scripts/check-content.ts",
    "check:render": "node scripts/render-check.ts",
    "test:aifn": "vitest run --config aifn-js/core/vitest.config.ts && vitest run --config aifn-js/methods/vitest.config.ts",
    "lab": "vite --config aifn-js/lab/vite.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/geist": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@mdx-js/react": "^3.1.1",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "echarts": "^6.1.0",
    "katex": "0.16.47",
    "lucide-react": "^1.48.0",
    "minisearch": "^7.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "shadcn": "^4.21.0",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "github-slugger": "^2.0.0",
    "json-schema-to-typescript": "^16.0.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx-frontmatter": "^6.0.0",
    "remark-smartypants": "^3.0.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "workspaces": [
    "aifn-js/core",
    "aifn-js/methods",
    "aifn-js/render",
    "aifn-js/lab"
  ]
}
