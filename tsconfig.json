{
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.node.json"
    },
    {
      "path": "./tsconfig.aifn.json"
    },
    {
      "path": "./tsconfig.render.json"
    },
    {
      "path": "./tsconfig.lab.json"
    },
    {
      "path": "./tsconfig.examples.json"
    }
  ],
  "compilerOptions": {
    "paths": {
      "@/*": ["./site/src/*"],
      "@content/*": ["./content/*"],
      "@design/*": ["./design/*"],
      "@python/*": ["./python/*"],
      "@lab/*": ["./aifn-js/sandbox/lab/src/*"],
      "@examples/*": ["./aifn-js/examples/src/*"],
      "@render/*": ["./aifn-js/render/src/*"],
      "aifn": ["./aifn-js/core/src/index.ts"],
      "aifn/*": ["./aifn-js/core/src/*"],
      "aifn-methods": ["./aifn-js/methods/src/index.ts"],
      "aifn-methods/*": ["./aifn-js/methods/src/*"],
      "aifn-render": ["./aifn-js/render/src/index.ts"],
      "aifn-render/*": ["./aifn-js/render/src/*"]
    }
  },
  "mdx": {
    "plugins": [["remark-frontmatter", ["yaml"]], "remark-gfm", "remark-math"]
  }
}
