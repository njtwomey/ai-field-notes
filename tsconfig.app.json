{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./site/src/*"],
      "@content/*": ["./content/*"],
      "@design/*": ["./design/*"],
      "@python/*": ["./python/*"],
      "@render/*": ["./aifn-js/render/src/*"],
      "aifn": ["./aifn-js/core/src/index.ts"],
      "aifn/*": ["./aifn-js/core/src/*"],
      "aifn-applied/*": ["./aifn-js/methods/src/*"],
      "aifn-render": ["./aifn-js/render/src/index.ts"],
      "aifn-render/*": ["./aifn-js/render/src/*"]
    }
  },
  "include": ["site/src", "content", "design"]
}
