{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lab.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client", "node"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "paths": {
      "@render/*": ["./aifn-js/render/src/*"],
      "aifn-render": ["./aifn-js/render/src/index.ts"],
      "aifn-render/*": ["./aifn-js/render/src/*"],
      "@lab/controls": ["./aifn-js/render/src/controls/index.ts"],
      "@lab/controls/*": ["./aifn-js/render/src/controls/*"],
      "@lab/design": ["./aifn-js/render/src/design/index.ts"],
      "@lab/design/*": ["./aifn-js/render/src/design/*"],
      "@lab/diagram": ["./aifn-js/render/src/diagram/index.ts"],
      "@lab/diagram/*": ["./aifn-js/render/src/diagram/*"],
      "@lab/state": ["./aifn-js/render/src/state/index.ts"],
      "@lab/state/*": ["./aifn-js/render/src/state/*"],
      "@lab/ui/*": ["./aifn-js/render/src/ui/*"],
      "@lab/viz": ["./aifn-js/render/src/viz/index.ts"],
      "@lab/viz/*": ["./aifn-js/render/src/viz/*"],
      "@lab/lib/*": ["./aifn-js/render/src/lib/*"],
      "@lab/*": ["./aifn-js/lab/src/*"],
      "aifn-js/modules.json": ["./aifn-js/modules.json"]
    }
  },
  "include": ["aifn-js/lab/src", "aifn-js/lab/vite.config.ts", "aifn-js/lab/check.ts", "aifn-js/lab/screenshot.ts"]
}
