{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contracts",
  "description": "Generated from python/mlc/core/contracts.py by `uv run mlc schema`. Do not edit.",
  "type": "object",
  "properties": {
    "Manifest": {
      "$ref": "#/$defs/Manifest"
    },
    "RunRecord": {
      "$ref": "#/$defs/RunRecord"
    },
    "Registry": {
      "$ref": "#/$defs/Registry"
    },
    "Point2d": {
      "$ref": "#/$defs/Point2d"
    },
    "PointCloud2d": {
      "$ref": "#/$defs/PointCloud2d"
    },
    "Samples1d": {
      "$ref": "#/$defs/Samples1d"
    },
    "Curve": {
      "$ref": "#/$defs/Curve"
    },
    "CurveSet": {
      "$ref": "#/$defs/CurveSet"
    },
    "Grid2d": {
      "$ref": "#/$defs/Grid2d"
    },
    "ContingencyTable": {
      "$ref": "#/$defs/ContingencyTable"
    },
    "RocCurve": {
      "$ref": "#/$defs/RocCurve"
    },
    "ElasticNetPaths": {
      "$ref": "#/$defs/ElasticNetPaths"
    },
    "FontManifoldData": {
      "$ref": "#/$defs/FontManifoldData"
    },
    "ImageSvd": {
      "$ref": "#/$defs/ImageSvd"
    },
    "LarsPaths": {
      "$ref": "#/$defs/LarsPaths"
    },
    "LassoPath": {
      "$ref": "#/$defs/LassoPath"
    },
    "LogisticValley": {
      "$ref": "#/$defs/LogisticValley"
    },
    "LossSurface": {
      "$ref": "#/$defs/LossSurface"
    },
    "ModelSelectionTable": {
      "$ref": "#/$defs/ModelSelectionTable"
    },
    "RegressionSurface": {
      "$ref": "#/$defs/RegressionSurface"
    },
    "RidgePath": {
      "$ref": "#/$defs/RidgePath"
    },
    "SgdTrajectories": {
      "$ref": "#/$defs/SgdTrajectories"
    },
    "SolverDatasets": {
      "$ref": "#/$defs/SolverDatasets"
    },
    "TypeIErrorMaps": {
      "$ref": "#/$defs/TypeIErrorMaps"
    }
  },
  "$defs": {
    "Cell": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "ChartOutput": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "const": "chart",
          "default": "chart",
          "type": "string"
        },
        "mime": {
          "const": "application/vnd.mlc.chart+json",
          "default": "application/vnd.mlc.chart+json",
          "type": "string"
        },
        "x_label": {
          "default": "x",
          "type": "string"
        },
        "y_label": {
          "default": "y",
          "type": "string"
        },
        "series": {
          "items": {
            "$ref": "#/$defs/Series"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "title",
        "kind",
        "mime",
        "x_label",
        "y_label",
        "series"
      ],
      "title": "ChartOutput",
      "type": "object"
    },
    "CoefficientPath": {
      "additionalProperties": false,
      "description": "Coefficients of a regularised fit along a grid of penalty values, one row per feature.",
      "properties": {
        "features": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "penalty": {
          "description": "Penalty values, decreasing: from all-zero (or near) to least penalised.",
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "coef": {
          "description": "Indexed [feature][penalty index].",
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "type": "array"
        }
      },
      "required": [
        "features",
        "penalty",
        "coef"
      ],
      "title": "CoefficientPath",
      "type": "object"
    },
    "ContingencyTable": {
      "additionalProperties": false,
      "description": "Counts cross-tabulated by two categorical variables. A confusion matrix is the special case rows=actual.",
      "properties": {
        "row_label": {
          "type": "string"
        },
        "col_label": {
          "type": "string"
        },
        "rows": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cols": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "counts": {
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "type": "array"
        }
      },
      "required": [
        "row_label",
        "col_label",
        "rows",
        "cols",
        "counts"
      ],
      "title": "ContingencyTable",
      "type": "object"
    },
    "Curve": {
      "additionalProperties": false,
      "description": "One named y-against-x line, e.g. a training-loss curve.",
      "properties": {
        "name": {
          "type": "string"
        },
        "x": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "y": {
          "items": {
            "type": "number"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "x",
        "y"
      ],
      "title": "Curve",
      "type": "object"
    },
    "CurveSet": {
      "additionalProperties": false,
      "description": "Curves that share axes, e.g. train and validation loss.",
      "properties": {
        "x_label": {
          "type": "string"
        },
        "y_label": {
          "type": "string"
        },
        "curves": {
          "items": {
            "$ref": "#/$defs/Curve"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "x_label",
        "y_label",
        "curves"
      ],
      "title": "CurveSet",
      "type": "object"
    },
    "DroppedFont": {
      "additionalProperties": false,
      "properties": {
        "font": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "font",
        "reason"
      ],
      "title": "DroppedFont",
      "type": "object"
    },
    "ElasticNetPaths": {
      "additionalProperties": false,
      "description": "Elastic-net paths for several mixing ratios; ratio 1 is the lasso.",
      "properties": {
        "l1_ratios": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "paths": {
          "items": {
            "$ref": "#/$defs/CoefficientPath"
          },
          "type": "array"
        }
      },
      "required": [
        "l1_ratios",
        "paths"
      ],
      "title": "ElasticNetPaths",
      "type": "object"
    },
    "ExampleIndex": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Slug"
        },
        "title": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "sources": {
          "description": "Repo-relative paths of every source file, in display order.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "runs": {
          "items": {
            "$ref": "#/$defs/RunIndex"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "module",
        "sources",
        "runs"
      ],
      "title": "ExampleIndex",
      "type": "object"
    },
    "ExampleSpec": {
      "additionalProperties": false,
      "description": "A runnable implementation attached to a note. ``id`` is referenced by a note's ``code`` frontmatter field.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Slug"
        },
        "title": {
          "type": "string"
        },
        "module": {
          "pattern": "^mlc\\.examples\\.[a-z_][a-z0-9_]*$",
          "type": "string"
        },
        "runs": {
          "items": {
            "$ref": "#/$defs/RunSpec"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "module",
        "runs"
      ],
      "title": "ExampleSpec",
      "type": "object"
    },
    "FigureId": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)+$",
      "type": "string"
    },
    "FigureIndex": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/FigureId"
        },
        "title": {
          "type": "string"
        },
        "path": {
          "description": "Relative to ``generated/``.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "path"
      ],
      "title": "FigureIndex",
      "type": "object"
    },
    "FileOutput": {
      "additionalProperties": false,
      "description": "A binary or large asset written next to the run record, e.g. a PNG.",
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "const": "file",
          "default": "file",
          "type": "string"
        },
        "mime": {
          "type": "string"
        },
        "path": {
          "description": "Relative to the run directory.",
          "type": "string"
        }
      },
      "required": [
        "title",
        "kind",
        "mime",
        "path"
      ],
      "title": "FileOutput",
      "type": "object"
    },
    "FittedMixture": {
      "additionalProperties": false,
      "description": "A diagonal-covariance Gaussian mixture in 2-D.",
      "properties": {
        "weights": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "means": {
          "items": {
            "$ref": "#/$defs/Point2d"
          },
          "type": "array"
        },
        "variances": {
          "description": "Per-component variances along x and y.",
          "items": {
            "$ref": "#/$defs/Point2d"
          },
          "type": "array"
        }
      },
      "required": [
        "weights",
        "means",
        "variances"
      ],
      "title": "FittedMixture",
      "type": "object"
    },
    "FontClass": {
      "enum": [
        "sans",
        "humanist",
        "serif",
        "didone",
        "slab",
        "mono"
      ],
      "type": "string"
    },
    "FontInfo": {
      "additionalProperties": false,
      "description": "One training font: a family instanced at one weight, width and posture.",
      "properties": {
        "family": {
          "type": "string"
        },
        "style": {
          "description": "Style label, e.g. 'Bold Italic'.",
          "type": "string"
        },
        "cls": {
          "$ref": "#/$defs/FontClass",
          "description": "Design class, for colouring the latent space."
        },
        "weight": {
          "description": "CSS weight, 100 to 900.",
          "type": "integer"
        },
        "width": {
          "description": "Width as a percentage of normal.",
          "type": "integer"
        },
        "italic": {
          "type": "boolean"
        }
      },
      "required": [
        "family",
        "style",
        "cls",
        "weight",
        "width",
        "italic"
      ],
      "title": "FontInfo",
      "type": "object"
    },
    "FontManifoldData": {
      "additionalProperties": false,
      "description": "Glyph outlines of real fonts in dense correspondence: one integer vector per font.",
      "properties": {
        "source": {
          "description": "Pinned repository commit the fonts come from.",
          "type": "string"
        },
        "cap_height": {
          "type": "integer"
        },
        "display": {
          "description": "The word the figure sets.",
          "type": "string"
        },
        "fonts": {
          "items": {
            "$ref": "#/$defs/FontInfo"
          },
          "type": "array"
        },
        "glyphs": {
          "items": {
            "$ref": "#/$defs/GlyphLayout"
          },
          "type": "array"
        },
        "vectors": {
          "description": "One row per font: x, y of every sample of every contour of every glyph, then advance widths.",
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "type": "array"
        },
        "handle": {
          "description": "Sample index (into the display word's P, outer contour) of the foot-serif tip.",
          "type": "integer"
        },
        "anchor": {
          "description": "Sample index on the left edge of the P's stem, held fixed while the serif is dragged.",
          "type": "integer"
        },
        "dropped": {
          "items": {
            "$ref": "#/$defs/DroppedFont"
          },
          "type": "array"
        }
      },
      "required": [
        "source",
        "cap_height",
        "display",
        "fonts",
        "glyphs",
        "vectors",
        "handle",
        "anchor",
        "dropped"
      ],
      "title": "FontManifoldData",
      "type": "object"
    },
    "GlyphLayout": {
      "additionalProperties": false,
      "description": "Where one character sits in every font vector.",
      "properties": {
        "char": {
          "type": "string"
        },
        "contours": {
          "description": "Samples per contour: the outer contour first, then counters.",
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "offset": {
          "description": "Index in the vector of the first coordinate (x of sample 0 of contour 0).",
          "type": "integer"
        },
        "advance": {
          "description": "Index in the vector of the advance width.",
          "type": "integer"
        }
      },
      "required": [
        "char",
        "contours",
        "offset",
        "advance"
      ],
      "title": "GlyphLayout",
      "type": "object"
    },
    "Grid2d": {
      "additionalProperties": false,
      "description": "Values on a regular grid, e.g. a loss surface or a probability map.",
      "properties": {
        "x": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "y": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "z": {
          "description": "Row-major: ``z[i][j]`` is the value at ``(x[j], y[i])``.",
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "type": "array"
        },
        "x_label": {
          "default": "x",
          "type": "string"
        },
        "y_label": {
          "default": "y",
          "type": "string"
        },
        "z_label": {
          "default": "value",
          "type": "string"
        }
      },
      "required": [
        "x",
        "y",
        "z",
        "x_label",
        "y_label",
        "z_label"
      ],
      "title": "Grid2d",
      "type": "object"
    },
    "HeatmapOutput": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "const": "heatmap",
          "default": "heatmap",
          "type": "string"
        },
        "mime": {
          "const": "application/vnd.mlc.heatmap+json",
          "default": "application/vnd.mlc.heatmap+json",
          "type": "string"
        },
        "x": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "y": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "z": {
          "description": "Row-major: ``z[i][j]`` is the value at ``(x[j], y[i])``.",
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "type": "array"
        },
        "x_label": {
          "default": "x",
          "type": "string"
        },
        "y_label": {
          "default": "y",
          "type": "string"
        },
        "overlay": {
          "items": {
            "$ref": "#/$defs/Series"
          },
          "type": "array"
        }
      },
      "required": [
        "title",
        "kind",
        "mime",
        "x",
        "y",
        "z",
        "x_label",
        "y_label",
        "overlay"
      ],
      "title": "HeatmapOutput",
      "type": "object"
    },
    "ImageSvd": {
      "additionalProperties": false,
      "description": "A test image and its thin SVD. The site rebuilds any rank-k approximation from these factors.",
      "properties": {
        "image": {
          "description": "Row-major, first row at the top, values in [0, 1].",
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "type": "array"
        },
        "u": {
          "description": "Shape (size, size): left singular vectors as columns.",
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "type": "array"
        },
        "s": {
          "description": "Singular values, largest first.",
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "vt": {
          "description": "Shape (size, size): right singular vectors as rows.",
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "type": "array"
        }
      },
      "required": [
        "image",
        "u",
        "s",
        "vt"
      ],
      "title": "ImageSvd",
      "type": "object"
    },
    "KnotPath": {
      "additionalProperties": false,
      "description": "A piecewise-linear path given by its knots; coefficients are linear in \u2016w\u2016\u2081 between consecutive knots.",
      "properties": {
        "l1_norm": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "alphas": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "coef": {
          "description": "Indexed [feature][knot].",
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "type": "array"
        },
        "events": {
          "description": "Features entering or leaving the active set, in order.",
          "items": {
            "$ref": "#/$defs/PathEvent"
          },
          "type": "array"
        }
      },
      "required": [
        "l1_norm",
        "alphas",
        "coef",
        "events"
      ],
      "title": "KnotPath",
      "type": "object"
    },
    "LarsPaths": {
      "additionalProperties": false,
      "description": "LARS and the LARS\u2013lasso modification on the diabetes data (Efron et al. 2004).",
      "properties": {
        "features": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "lar": {
          "$ref": "#/$defs/KnotPath"
        },
        "lasso": {
          "$ref": "#/$defs/KnotPath"
        }
      },
      "required": [
        "features",
        "lar",
        "lasso"
      ],
      "title": "LarsPaths",
      "type": "object"
    },
    "LassoPath": {
      "additionalProperties": false,
      "description": "Lasso coefficients against \u03b1 on the diabetes data, with the OLS solution.",
      "properties": {
        "path": {
          "$ref": "#/$defs/CoefficientPath"
        },
        "nonzero": {
          "description": "Number of nonzero coefficients at each \u03b1.",
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "ols": {
          "items": {
            "type": "number"
          },
          "type": "array"
        }
      },
      "required": [
        "path",
        "nonzero",
        "ols"
      ],
      "title": "LassoPath",
      "type": "object"
    },
    "LogisticValley": {
      "additionalProperties": false,
      "description": "Log-cross-entropy of a 1-D logistic regression over (w, b), with the data it was computed on.",
      "properties": {
        "surface": {
          "$ref": "#/$defs/Grid2d"
        },
        "data": {
          "$ref": "#/$defs/Samples1d"
        },
        "optimum": {
          "$ref": "#/$defs/Point2d",
          "description": "Exact (w, b), found by Newton's method."
        },
        "optimum_loss": {
          "type": "number"
        }
      },
      "required": [
        "surface",
        "data",
        "optimum",
        "optimum_loss"
      ],
      "title": "LogisticValley",
      "type": "object"
    },
    "LossSurface": {
      "additionalProperties": false,
      "description": "Cross-entropy over the two weights, with the dataset it was computed on.",
      "properties": {
        "surface": {
          "$ref": "#/$defs/Grid2d"
        },
        "data": {
          "$ref": "#/$defs/PointCloud2d"
        }
      },
      "required": [
        "surface",
        "data"
      ],
      "title": "LossSurface",
      "type": "object"
    },
    "Manifest": {
      "additionalProperties": false,
      "description": "Written to ``generated/manifest.json``. The site's single entry point to generated assets.",
      "properties": {
        "examples": {
          "additionalProperties": {
            "$ref": "#/$defs/ExampleIndex"
          },
          "type": "object"
        },
        "figures": {
          "additionalProperties": {
            "$ref": "#/$defs/FigureIndex"
          },
          "type": "object"
        }
      },
      "required": [
        "examples",
        "figures"
      ],
      "title": "Manifest",
      "type": "object"
    },
    "MetricsOutput": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "const": "metrics",
          "default": "metrics",
          "type": "string"
        },
        "mime": {
          "const": "application/vnd.mlc.metrics+json",
          "default": "application/vnd.mlc.metrics+json",
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "type": "object"
        }
