{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contracts",
  "description": "Generated from python/mlc/core/contracts.py by `uv run mlc schema`. Do not edit.",
  "type": "object",
  "properties": {
    "Manifest": {
      "$ref": "#/$defs/Manifest"
    },
    "RunRecord": {
      "$ref": "#/$defs/RunRecord"
    },
    "Registry": {
      "$ref": "#/$defs/Registry"
    },
    "Point2d": {
      "$ref": "#/$defs/Point2d"
    },
    "PointCloud2d": {
      "$ref": "#/$defs/PointCloud2d"
    },
    "Samples1d": {
      "$ref": "#/$defs/Samples1d"
    },
    "Curve": {
      "$ref": "#/$defs/Curve"
    },
    "CurveSet": {
      "$ref": "#/$defs/CurveSet"
    },
    "Grid2d": {
      "$ref": "#/$defs/Grid2d"
    },
    "ContingencyTable": {
      "$ref": "#/$defs/ContingencyTable"
    },
    "RocCurve": {
      "$ref": "#/$defs/RocCurve"
    },
    "LogisticValley": {
      "$ref": "#/$defs/LogisticValley"
    },
    "LossSurface": {
      "$ref": "#/$defs/LossSurface"
    },
    "ModelSelectionTable": {
      "$ref": "#/$defs/ModelSelectionTable"
    },
    "RegressionSurface": {
      "$ref": "#/$defs/RegressionSurface"
    }
  },
  "$defs": {
    "Cell": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "ChartOutput": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "const": "chart",
          "default": "chart",
          "type": "string"
        },
        "mime": {
          "const": "application/vnd.mlc.chart+json",
          "default": "application/vnd.mlc.chart+json",
          "type": "string"
        },
        "x_label": {
          "default": "x",
          "type": "string"
        },
        "y_label": {
          "default": "y",
          "type": "string"
        },
        "series": {
          "items": {
            "$ref": "#/$defs/Series"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "title",
        "kind",
        "mime",
        "x_label",
        "y_label",
        "series"
      ],
      "title": "ChartOutput",
      "type": "object"
    },
    "ContingencyTable": {
      "additionalProperties": false,
      "description": "Counts cross-tabulated by two categorical variables. A confusion matrix is the special case rows=actual.",
      "properties": {
        "row_label": {
          "type": "string"
        },
        "col_label": {
          "type": "string"
        },
        "rows": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cols": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "counts": {
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "type": "array"
        }
      },
      "required": [
        "row_label",
        "col_label",
        "rows",
        "cols",
        "counts"
      ],
      "title": "ContingencyTable",
      "type": "object"
    },
    "Curve": {
      "additionalProperties": false,
      "description": "One named y-against-x line, e.g. a training-loss curve.",
      "properties": {
        "name": {
          "type": "string"
        },
        "x": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "y": {
          "items": {
            "type": "number"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "x",
        "y"
      ],
      "title": "Curve",
      "type": "object"
    },
    "CurveSet": {
      "additionalProperties": false,
      "description": "Curves that share axes, e.g. train and validation loss.",
      "properties": {
        "x_label": {
          "type": "string"
        },
        "y_label": {
          "type": "string"
        },
        "curves": {
          "items": {
            "$ref": "#/$defs/Curve"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "x_label",
        "y_label",
        "curves"
      ],
      "title": "CurveSet",
      "type": "object"
    },
    "ExampleIndex": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Slug"
        },
        "title": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "sources": {
          "description": "Repo-relative paths of every source file, in display order.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "runs": {
          "items": {
            "$ref": "#/$defs/RunIndex"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "module",
        "sources",
        "runs"
      ],
      "title": "ExampleIndex",
      "type": "object"
    },
    "ExampleSpec": {
      "additionalProperties": false,
      "description": "A runnable implementation attached to a note. ``id`` is referenced by a note's ``code`` frontmatter field.",
      "properties": {
        "id": {
          "$ref": "#/$defs/Slug"
        },
        "title": {
          "type": "string"
        },
        "module": {
          "pattern": "^mlc\\.examples\\.[a-z_][a-z0-9_]*$",
          "type": "string"
        },
        "runs": {
          "items": {
            "$ref": "#/$defs/RunSpec"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "module",
        "runs"
      ],
      "title": "ExampleSpec",
      "type": "object"
    },
    "FigureId": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)+$",
      "type": "string"
    },
    "FigureIndex": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/FigureId"
        },
        "title": {
          "type": "string"
        },
        "path": {
          "description": "Relative to ``generated/``.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "path"
      ],
      "title": "FigureIndex",
      "type": "object"
    },
    "FileOutput": {
      "additionalProperties": false,
      "description": "A binary or large asset written next to the run record, e.g. a PNG.",
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "const": "file",
          "default": "file",
          "type": "string"
        },
        "mime": {
          "type": "string"
        },
        "path": {
          "description": "Relative to the run directory.",
          "type": "string"
        }
      },
      "required": [
        "title",
        "kind",
        "mime",
        "path"
      ],
      "title": "FileOutput",
      "type": "object"
    },
    "Grid2d": {
      "additionalProperties": false,
      "description": "Values on a regular grid, e.g. a loss surface or a probability map.",
      "properties": {
        "x": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "y": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "z": {
          "description": "Row-major: ``z[i][j]`` is the value at ``(x[j], y[i])``.",
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "type": "array"
        },
        "x_label": {
          "default": "x",
          "type": "string"
        },
        "y_label": {
          "default": "y",
          "type": "string"
        },
        "z_label": {
          "default": "value",
          "type": "string"
        }
      },
      "required": [
        "x",
        "y",
        "z",
        "x_label",
        "y_label",
        "z_label"
      ],
      "title": "Grid2d",
      "type": "object"
    },
    "HeatmapOutput": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "const": "heatmap",
          "default": "heatmap",
          "type": "string"
        },
        "mime": {
          "const": "application/vnd.mlc.heatmap+json",
          "default": "application/vnd.mlc.heatmap+json",
          "type": "string"
        },
        "x": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "y": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "z": {
          "description": "Row-major: ``z[i][j]`` is the value at ``(x[j], y[i])``.",
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "type": "array"
        },
        "x_label": {
          "default": "x",
          "type": "string"
        },
        "y_label": {
          "default": "y",
          "type": "string"
        },
        "overlay": {
          "items": {
            "$ref": "#/$defs/Series"
          },
          "type": "array"
        }
      },
      "required": [
        "title",
        "kind",
        "mime",
        "x",
        "y",
        "z",
        "x_label",
        "y_label",
        "overlay"
      ],
      "title": "HeatmapOutput",
      "type": "object"
    },
    "LogisticValley": {
      "additionalProperties": false,
      "description": "Log-cross-entropy of a 1-D logistic regression over (w, b), with the data it was computed on.",
      "properties": {
        "surface": {
          "$ref": "#/$defs/Grid2d"
        },
        "data": {
          "$ref": "#/$defs/Samples1d"
        },
        "optimum": {
          "$ref": "#/$defs/Point2d",
          "description": "Exact (w, b), found by Newton's method."
        },
        "optimum_loss": {
          "type": "number"
        }
      },
      "required": [
        "surface",
        "data",
        "optimum",
        "optimum_loss"
      ],
      "title": "LogisticValley",
      "type": "object"
    },
    "LossSurface": {
      "additionalProperties": false,
      "description": "Cross-entropy over the two weights, with the dataset it was computed on.",
      "properties": {
        "surface": {
          "$ref": "#/$defs/Grid2d"
        },
        "data": {
          "$ref": "#/$defs/PointCloud2d"
        }
      },
      "required": [
        "surface",
        "data"
      ],
      "title": "LossSurface",
      "type": "object"
    },
    "Manifest": {
      "additionalProperties": false,
      "description": "Written to ``generated/manifest.json``. The site's single entry point to generated assets.",
      "properties": {
        "examples": {
          "additionalProperties": {
            "$ref": "#/$defs/ExampleIndex"
          },
          "type": "object"
        },
        "figures": {
          "additionalProperties": {
            "$ref": "#/$defs/FigureIndex"
          },
          "type": "object"
        }
      },
      "required": [
        "examples",
        "figures"
      ],
      "title": "Manifest",
      "type": "object"
    },
    "MetricsOutput": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "const": "metrics",
          "default": "metrics",
          "type": "string"
        },
        "mime": {
          "const": "application/vnd.mlc.metrics+json",
          "default": "application/vnd.mlc.metrics+json",
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "type": "object"
        }
      },
      "required": [
        "title",
        "kind",
        "mime",
        "values"
      ],
      "title": "MetricsOutput",
      "type": "object"
    },
    "ModelSelectionTable": {
      "additionalProperties": false,
      "description": "Deviance \u22122 log L of the best EM fit for every sample size, restart budget and k. AIC and BIC follow from it.",
      "properties": {
        "ks": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "ns": {
          "description": "Sample sizes. Each uses the first n points of `blobs`, which are a random subsample.",
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "max_restarts": {
          "type": "integer"
        },
        "deviance": {
          "description": "Indexed [restarts \u2212 1][n index][k index].",
          "items": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array"
          },
          "type": "array"
        }
      },
      "required": [
        "ks",
        "ns",
        "max_restarts",
        "deviance"
      ],
      "title": "ModelSelectionTable",
      "type": "object"
    },
    "Output": {
      "discriminator": {
        "mapping": {
          "chart": "#/$defs/ChartOutput",
          "file": "#/$defs/FileOutput",
          "heatmap": "#/$defs/HeatmapOutput",
          "metrics": "#/$defs/MetricsOutput",
          "table": "#/$defs/TableOutput",
          "text": "#/$defs/TextOutput"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/TextOutput"
        },
        {
          "$ref": "#/$defs/MetricsOutput"
        },
        {
          "$ref": "#/$defs/TableOutput"
        },
        {
          "$ref": "#/$defs/ChartOutput"
        },
        {
          "$ref": "#/$defs/HeatmapOutput"
        },
        {
          "$ref": "#/$defs/FileOutput"
        }
      ]
    },
    "Point2d": {
      "additionalProperties": false,
      "description": "A single point, e.g. an optimum in parameter space. Use instead of a tuple: tuples lose their types in the\ngenerated TypeScript.",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Point2d",
      "type": "object"
    },
    "PointCloud2d": {
      "additionalProperties": false,
      "description": "Points in the plane, optionally labelled with a categorical group per point.",
      "properties": {
        "x": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "y": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "group": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Categorical palette slot per point."
        },
        "group_names": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Display name per group index."
        }
      },
      "required": [
        "x",
        "y",
        "group",
        "group_names"
      ],
      "title": "PointCloud2d",
      "type": "object"
    },
    "Registry": {
      "additionalProperties": false,
      "properties": {
        "examples": {
          "items": {
            "$ref": "#/$defs/ExampleSpec"
          },
          "type": "array"
        }
      },
      "required": [
        "examples"
      ],
      "title": "Registry",
      "type": "object"
    },
    "RegressionSurface": {
      "additionalProperties": false,
      "description": "Log-MSE of y \u2248 w\u00b7x + b over (w, b), with the data it was computed on.",
      "properties": {
        "surface": {
          "$ref": "#/$defs/Grid2d"
        },
        "data": {
          "$ref": "#/$defs/PointCloud2d"
        },
        "optimum": {
          "$ref": "#/$defs/Point2d",
          "description": "Exact least-squares (w, b)."
        },
        "optimum_loss": {
          "type": "number"
        }
      },
      "required": [
        "surface",
        "data",
        "optimum",
        "optimum_loss"
      ],
      "title": "RegressionSurface",
      "type": "object"
    },
    "RocCurve": {
      "additionalProperties": false,
      "description": "Receiver operating characteristic: true-positive rate against false-positive rate over thresholds.",
      "properties": {
        "fpr": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "tpr": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "thresholds": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "auc": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "required": [
        "fpr",
        "tpr",
        "thresholds",
        "auc"
      ],
      "title": "RocCurve",
      "type": "object"
    },
    "RunIndex": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/Slug"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "path": {
          "description": "Relative to ``generated/``.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "title",
        "description",
        "command",
        "exit_code",
        "path"
      ],
      "title": "RunIndex",
      "type": "object"
    },
    "RunRecord": {
      "additionalProperties": false,
      "description": "Written to ``generated/runs/<example>/<run>/run.json``.",
      "properties": {
        "example": {
          "$ref": "#/$defs/Slug"
        },
        "run": {
          "$ref": "#/$defs/Slug"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "duration_s": {
          "type": "number"
        },
        "hash": {
          "type": "string"
        },
        "created": {
          "type": "string"
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/Output"
          },
          "type": "array"
        }
      },
      "required": [
        "example",
        "run",
        "title",
        "description",
        "command",
        "exit_code",
        "duration_s",
        "hash",
        "created",
        "stdout",
        "stderr",
        "outputs"
      ],
      "title": "RunRecord",
      "type": "object"
    },
    "RunSpec": {
      "additionalProperties": false,
      "description": "One CLI invocation of an example. Its outputs are cached as static assets.",
      "properties": {
        "name": {
          "$ref": "#/$defs/Slug"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "args": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "title",
        "description",
        "args"
      ],
      "title": "RunSpec",
      "type": "object"
    },
    "Samples1d": {
      "additionalProperties": false,
      "description": "Scalar samples, optionally labelled with a categorical group per sample, e.g. a 1-D classification dataset.",
      "properties": {
        "x": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "group": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Categorical palette slot per sample."
        },
        "group_names": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Display name per group index."
        }
      },
      "required": [
        "x",
        "group",
        "group_names"
      ],
      "title": "Samples1d",
      "type": "object"
    },
    "Series": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "enum": [
            "scatter",
            "line"
          ],
          "type": "string"
        },
        "x": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "y": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "group": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional categorical slot index per point (scatter only). Colours follow design/palette.json."
        }
      },
      "required": [
        "name",
        "type",
        "x",
        "y",
        "group"
      ],
      "title": "Series",
      "type": "object"
    },
    "Slug": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "TableOutput": {
      "additionalProperties": false,
